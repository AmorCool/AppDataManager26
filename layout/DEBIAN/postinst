#!/bin/bash

# AppData Manager Post-Installation Script
# Rootless Jailbreak Compatible

set -e

echo "========================================"
echo "  AppData Manager v1.0.0"
echo "  Installing..."
echo "========================================"

# إنشاء مجلد النسخ الاحتياطية إذا لم يكن موجوداً
BACKUP_DIR="/var/mobile/Documents/AppDataBackups"
if [ ! -d "$BACKUP_DIR" ]; then
    mkdir -p "$BACKUP_DIR"
    chown mobile:mobile "$BACKUP_DIR"
    chmod 755 "$BACKUP_DIR"
    echo "✅ Backup directory created"
fi

# تحديث uicache
if command -v uicache &> /dev/null; then
    uicache -p /var/jb/Applications/AppDataManager.app 2>/dev/null || uicache -p /Applications/AppDataManager.app 2>/dev/null || true
    echo "✅ Cache updated"
fi

# إعادة تشغيل SpringBoard (اختياري)
# killall -9 SpringBoard 2>/dev/null || true

echo ""
echo "✅ Installation complete!"
echo "📱 Open 'AppData Manager' from your home screen."
echo ""

exit 0
