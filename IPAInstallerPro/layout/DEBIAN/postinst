#!/bin/bash
set -e

echo "=== IPA Installer Pro Post-Install ==="

# Find the helper binary (Rootless or legacy)
HELPER="/var/jb/usr/bin/ipainstallerpro_helper"
if [ ! -f "$HELPER" ]; then
    HELPER="/usr/bin/ipainstallerpro_helper"
fi

if [ -f "$HELPER" ]; then
    echo "Setting up root helper at $HELPER"
    chmod 4755 "$HELPER"
    chown root:wheel "$HELPER"
    echo "Root helper ready (setuid root)"
else
    echo "WARNING: Root helper not found at $HELPER"
    echo "Direct installation may fail without root privileges."
fi

# Refresh UI cache for the app
echo "Refreshing UI cache..."
uicache -p /var/jb/Applications/IPAInstallerPro.app 2>/dev/null || uicache -p /Applications/IPAInstallerPro.app 2>/dev/null || true

echo "=== Done ==="
exit 0
